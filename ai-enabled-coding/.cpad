{
  "targets": {
    "run_main_py": {
      "label": "Main (main.py)",
      "command": "python src/main.py"
    },
    "test_test_puzzle_py": {
      "label": "Test (test_puzzle.py)",
      "command": "python src/test_puzzle.py"
    },
    "test_test_solver_py": {
      "label": "Test (test_solver.py)",
      "command": "python src/test_solver.py"
    },
    "format": {
      "label": "Format",
      "command": "/home/coderpad/.local/bin/black src/"
    },
    "dbg_run_main_py": {
      "label": "ipdb Main (main.py)",
      "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
    },
    "dbg_test_test_puzzle_py": {
      "label": "ipdb Test (test_puzzle.py)",
      "command": "/home/coderpad/.local/bin/ipdb3 src/test_puzzle.py"
    },
    "dbg_test_test_solver_py": {
      "label": "ipdb Test (test_solver.py)",
      "command": "/home/coderpad/.local/bin/ipdb3 src/test_solver.py"
    }
  }
}
